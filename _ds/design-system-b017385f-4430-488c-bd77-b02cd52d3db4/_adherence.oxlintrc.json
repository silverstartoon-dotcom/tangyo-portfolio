{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/pitch/**",
              "components/work/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard|Pretendard Fallback))/i]",
        "message": "Font not provided by the design system. Available: Pretendard, Pretendard Fallback."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|block|disabled|trailing|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, block, disabled, trailing, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|inverse|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'inverse' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|note|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<CharacterCard> doesn't accept that prop. Declared props: src, name, note, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|accent|ink)$/]",
        "message": "<CharacterCard> tone must be one of 'paper' | 'accent' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CharacterCard> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|style|key|ref|className|style|children)$/]",
        "message": "<CopyField> doesn't accept that prop. Declared props: value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfferCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|title|description|thumb|tone|href|style|key|ref|className|style|children)$/]",
        "message": "<OfferCard> doesn't accept that prop. Declared props: code, title, description, thumb, tone, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfferCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|paper)$/]",
        "message": "<OfferCard> tone must be one of 'dark' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|code|title|description|last|style|key|ref|className|style|children)$/]",
        "message": "<ProcessStep> doesn't accept that prop. Declared props: index, code, title, description, last, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, index, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|muted|plain)$/]",
        "message": "<SectionLabel> tone must be one of 'accent' | 'muted' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|note|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatFigure> doesn't accept that prop. Declared props: label, value, unit, note, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|plain)$/]",
        "message": "<StatFigure> tone must be one of 'accent' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<StatFigure> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|outline|paper)$/]",
        "message": "<Tag> tone must be one of 'default' | 'accent' | 'outline' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Tag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToonCarousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:slides|ratio|label|treatment|style|key|ref|className|style|children)$/]",
        "message": "<ToonCarousel> doesn't accept that prop. Declared props: slides, ratio, label, treatment, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToonCarousel'] > JSXAttribute[name.name='treatment'] > Literal[value!=/^(?:none|duotone)$/]",
        "message": "<ToonCarousel> treatment must be one of 'none' | 'duotone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkCase'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|brand|categories|objective|approach|result|slides|ratio|carouselLabel|reverse|style|key|ref|className|style|children)$/]",
        "message": "<WorkCase> doesn't accept that prop. Declared props: index, brand, categories, objective, approach, result, slides, ratio, carouselLabel, reverse, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
